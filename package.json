{
  "name": "cardano-bech32-utils",
  "version": "0.1.0",
  "description": "Tiny, zero-dependency TypeScript helpers for Cardano bech32 addresses: BIP-173 encode/decode, CIP-19 address inspection, CIP-5 prefixes and address builders.",
  "author": "Gildor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gildor853/cardano-bech32-utils.git"
  },
  "homepage": "https://github.com/Gildor853/cardano-bech32-utils#readme",
  "bugs": {
    "url": "https://github.com/Gildor853/cardano-bech32-utils/issues"
  },
  "keywords": [
    "cardano",
    "bech32",
    "cip19",
    "cip5",
    "address"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vite": "^6.4.4"
  }
}
